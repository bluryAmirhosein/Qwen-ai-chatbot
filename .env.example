# Model settings
MODEL_NAME=Qwen/Qwen3-1.7B
# Directory where model weights are downloaded/cached.
# Point this to a drive with enough free space (the model is ~2GB on first download).
MODEL_CACHE_DIR=D:/ai-models/qwen3-1.7b

#MODEL_NAME=Qwen/Qwen3-4B
#MODEL_CACHE_DIR=/home/chali/Qwen/Qwen-ai-chatbot/ai-models/qwen3-4b

MODEL_BACKEND=llama_cpp
GGUF_MODEL_PATH=/home/chali/Qwen/Qwen-ai-chatbot/ai-models/qwen3-4b-gguf/Qwen3-4B-Q4_K_M.gguf
# Context window in tokens. The prompt (system + history + RAG chunks) and the
# generated reply must fit in it together. If it is too small, replies get
# silently cut short. Uses roughly 1-1.5 GB more RAM than 4096; drop to 6144 or
# 4096 on a small server and keep MAX_NEW_TOKENS as is.
LLAMA_N_CTX=8192
# Set to the number of PHYSICAL cores once you know it
# LLAMA_N_THREADS=8

DEVICE=auto
# Upper bound on generated tokens, before the thinking-mode multiplier
# (fast x1, balanced x2, deep x3) is applied. Generation still ends as soon as
# the model finishes, so a higher cap costs nothing for short answers.
# Persian needs many tokens per word; too low a value cuts replies mid-sentence.
MAX_NEW_TOKENS=768
# Lower = more focused and consistent (good for RAG answers). If replies start
# to repeat themselves, raise it to 0.4-0.5.
TEMPERATURE=0.3

# Logging settings
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# PostgreSQL settings (used by both the postgres and app services)
POSTGRES_USER=qwen
POSTGRES_PASSWORD=change-me
POSTGRES_DB=qwen_chatbot
# Only needed if you uncomment the postgres "ports" mapping in docker-compose.yml
POSTGRES_PORT=5432